@baseUrl = http://localhost:3000
@phcId = {{phcs.response.body.$[0].id}}

### 0. Get PHCs
# @name phcs
GET {{baseUrl}}/api/phcs


### 1. Pregnant woman
POST {{baseUrl}}/api/patients
Content-Type: application/json

{
  "fullName": "Ngozi Okafor",
  "dateOfBirth": "1995-06-14",
  "gender": "FEMALE",
  "phone": "08031234567",
  "village": "Ifite",
  "lga": "Awka North",
  "state": "Anambra",
  "nextOfKinName": "Chidi Okafor",
  "nextOfKinPhone": "08051234567",
  "bloodGroup": "O_POSITIVE",
  "para": 1,
  "gravida": 3,
  "isPregnant": true,
  "phcId": "{{phcId}}"
}

### 2. Toddler with vaccines
POST {{baseUrl}}/api/patients
Content-Type: application/json

{
  "fullName": "Chiamaka Eze",
  "dateOfBirth": "2025-08-01",
  "gender": "FEMALE",
  "village": "Amansea",
  "lga": "Awka North",
  "state": "Anambra",
  "nextOfKinName": "Ada Eze",
  "nextOfKinPhone": "08061234567",
  "phcId": "{{phcId}}",
  "immunizations": [
    { "vaccineName": "BCG", "doseNumber": 1, "dateGiven": "2025-08-02" },
    { "vaccineName": "Penta", "doseNumber": 1, "dateGiven": "2025-09-15", "nextDueDate": "2025-10-27" }
  ]
}

